 "glossaire": [
  {
   "terme": "AppData",
   "definition": "L'objet racine du stockage : un profil et neuf journaux. La home le lit intégralement et ne l'écrit jamais."
  },
  {
   "terme": "byDateTimeDesc / byDateTimeAsc",
   "definition": "Comparateurs de journaux sur la clé `${date}T${time || '12:00'}` : heure absente = midi. À clé égale l'ordre du tableau subsiste (tri stable)."
  },
  {
   "terme": "hasOccurred",
   "definition": "Frontière du « déjà eu lieu » : comparaison de chaînes de date et d'heure locales, heure absente = déjà eu lieu, comparaison large à l'heure exacte."
  },
  {
   "terme": "isModuleOn",
   "definition": "État d'un module. Drapeau absent ou null : allumé pour injection et symptoms, éteint pour les cinq autres. Un onglet sans module (pesée) rend toujours vrai."
  },
  {
   "terme": "isModuleHidden",
   "definition": "Vrai seulement si le module est éteint ET son drapeau de masquage posé. Un module masqué est retiré des tables des tiroirs."
  },
  {
   "terme": "format1Dec / formatNumber",
   "definition": "Mise en forme des nombres du site : une décimale au plus (format1Dec) ou n au plus (formatNumber), zéros de queue supprimés, POINT décimal, milliers séparés d'une espace insécable, chaîne vide pour un non-nombre fini."
  },
  {
   "terme": "signedKg",
   "definition": "Écart de poids arrondi au dixième et toujours signé : « +3 », « -2.4 », « -0 » pour zéro."
  },
  {
   "terme": "cureWeek",
   "definition": "Semaine de cure depuis la pesée de départ : totalDays entre minuits locaux arrondi au jour, weekNumber = floor(totalDays / 7) + 1."
  },
  {
   "terme": "currentTreatmentInjections",
   "definition": "La série du traitement en cours : les prises remontées depuis la dernière ligne jusqu'au premier changement de fiche. Un changement est une coupure définitive."
  },
  {
   "terme": "currentTreatmentSeries",
   "definition": "La même série, mais le futur écarté par hasOccurred AVANT la coupure, plus le compte, la dose initiale, la dose actuelle et le total en mg."
  },
  {
   "terme": "bmiOf / getBmiTierInfo",
   "definition": "IMC arrondi au dixième (0 si la taille manque) et son palier indexé de 0 à 5, 99 pour « inconnu ». Un palier est franchi quand l'index actuel est strictement inférieur à celui du départ."
  },
  {
   "terme": "nutritionTotalsOn",
   "definition": "Somme des calories, protéines et fibres des repas d'une date, sans filtre d'heure ; macro absente comptée 0."
  },
  {
   "terme": "dailyNutritionGoals",
   "definition": "Objectifs du jour : calories 1400 par défaut, protéines round(poids actuel × 1.5), fibres 25. Un objectif enregistré à 0 est retenu tel quel."
  },
  {
   "terme": "periodShift",
   "definition": "Sens d'une période : somme des sept jours anciens contre celle des sept récents, seuil de 5 % sur le rapport à la période précédente. Une moitié à zéro est tranchée avant le rapport."
  },
  {
   "terme": "hasShape",
   "definition": "Condition de tracé d'une sparkline : au moins deux valeurs connues, et au moins deux valeurs différentes."
  },
  {
   "terme": "trendDates / TREND_DAYS",
   "definition": "Les quatorze dates locales de J−13 à aujourd'hui, du plus ancien au plus récent, qui portent les sept séries de tendance."
  },
  {
   "terme": "informedTrendMean",
   "definition": "Moyenne des seules valeurs non nulles d'une série, null si aucune."
  },
  {
   "terme": "getDivinationVerdict",
   "definition": "Verdict de la Dynamique sur le différentiel en grammes : stable jusqu'à 300 g inclus, légère hausse ou baisse en deçà de 1 000 g, marquée au-delà."
  },
  {
   "terme": "isDynamiqueUnlocked",
   "definition": "Déblocage de la section Dynamique : au moins sept jours locaux entre l'origine (clé stockée, sinon la plus ancienne donnée non future, sinon aujourd'hui) et aujourd'hui."
  },
  {
   "terme": "filterByTimeWindow / getCutoffDateStr",
   "definition": "Fenêtre temporelle inclusive comptant le jour en cours (décalage n − 1), comparée entre chaînes AAAA-MM-JJ. 'all' ne coupe rien, 'custom' applique les bornes non vides."
  },
  {
   "terme": "drawerItems",
   "definition": "Table d'un tiroir : les onglets de l'ordre donné, drapeaux forcés à true pour la sélection, moins les modules masqués, chacun porteur de son état enabled. Le tri allumés-d'abord est fait au rendu."
  },
  {
   "terme": "creerRng",
   "definition": "Générateur pseudo-aléatoire mulberry32 : même graine, même suite, donc même scène de félicitation."
  }
 ],
