 "glossaire": [
  {
   "terme": "pesée de départ",
   "definition": "La ligne de weightHistory portant isStartingWeight === true. Elle fixe le poids de départ, la date de début de cure et la borne basse de la durée d'une perte totale — jamais la pesée la plus ancienne."
  },
  {
   "terme": "coupure au changement de traitement",
   "definition": "Règle qui, en remontant l'historique des prises depuis la fin, s'arrête à la première ligne d'un autre traitement. Revenir à un traitement déjà pris n'en rouvre pas l'ancien épisode."
  },
  {
   "terme": "hasOccurred",
   "definition": "Prédicat « a déjà eu lieu » : date passée, ou date du jour avec une heure atteinte (heure absente = déjà eu lieu). Il écarte les saisies à venir de la Dynamique, de la série du traitement et des badges."
  },
  {
   "terme": "journée renseignée",
   "definition": "Dénominateur de la plupart des moyennes /jour : le nombre de dates distinctes portant au moins une entrée. Une journée sans saisie est une journée non tenue, pas un zéro."
  },
  {
   "terme": "série de tendance",
   "definition": "Quatorze valeurs, une par jour local de J−13 à aujourd'hui. Ce qui se cumule vaut 0 le jour sans saisie ; ce qui est un état (poids, concentration) se reporte ou se recalcule."
  },
  {
   "terme": "periodShift",
   "definition": "Comparaison des deux moitiés de sept jours d'une série ; hausse, baisse ou stable, avec un seuil de 5 % sur la moitié ancienne prise pour référence."
  },
  {
   "terme": "module",
   "definition": "Un des sept domaines commandés par un drapeau du profil. Absent, il vaut allumé pour le traitement et les effets secondaires, éteint pour les cinq autres. Un module éteint peut en outre être masqué."
  },
  {
   "terme": "différentiel (Dynamique)",
   "definition": "Calories ingérées moins dépenses sur sept jours ; converti en grammes à raison de 8 000 kcal pour un kilo, puis traduit en verdict par les seuils 300 g et 1 000 g."
  },
  {
   "terme": "fenêtre inclusive",
   "definition": "Convention des sélecteurs de période : « n derniers jours » couvre aujourd'hui et les n−1 jours précédents, la coupure étant une chaîne de date locale comparée en chaînes."
  },
  {
   "terme": "équivalence insolite",
   "definition": "Objet du quotidien assigné à une perte de poids par la pesée, vrai à 200 g près, jamais le même pour la perte totale et la dernière perte."
  },
  {
   "terme": "assignation persistée",
   "definition": "Le résultat de useLudicAssignment, écrit au fil des pesées et relu par la home ; la home sections le recalcule si la liste arrive vide alors que la perte est positive."
  },
  {
   "terme": "grandeur canonique",
   "definition": "L'unité de stockage et de calcul, sans étiquette : kg, cm, mg, minutes, kcal, pas. Les unités ne sont posées qu'à l'affichage."
  }
 ],
