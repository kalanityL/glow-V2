 "glossaire": [
  {
   "terme": "SleepLog",
   "definition": "Objet stocké d'une entrée de sommeil : id, date et time (le réveil), bedDate et bedTime (l'endormissement), kind ('nuit' | 'sieste'), quality 0–5, notes facultatives. La durée n'y figure pas."
  },
  {
   "terme": "Jour du réveil",
   "definition": "Le champ date d'une entrée. Convention du domaine : la nuit précédant le jour J porte la date J. Sert au tri, au calendrier, aux points de graphe, au plafond quotidien et à la tendance."
  },
  {
   "terme": "Plage (SleepRange)",
   "definition": "Les quatre champs bedDate, bedTime, date, time pris ensemble — les deux instants complets qui bornent un sommeil. C'est l'objet du contrôle de recouvrement."
  },
  {
   "terme": "instantMinutes",
   "definition": "Conversion d'un couple (date, heure) en minutes absolues, par Date.UTC champ par champ. Rend null sur un format invalide. Base de toutes les comparaisons du domaine."
  },
  {
   "terme": "Qualité pondérée (weightedQuality)",
   "definition": "Σ(durée × qualité) / Σ durée sur les entrées de durée > 0, arrondie au dixième ; null si la somme des durées est nulle."
  },
  {
   "terme": "Minute ronde (ROUNDED_MINUTES)",
   "definition": "L'ensemble {00, 10, 15, 20, 30, 40, 45, 50}. Toute heure enregistrée y est ramenée vers le bas par snapToRoundedMinutes, à l'écriture et non à la saisie."
  },
  {
   "terme": "Plafond quotidien (SLEEP_DAILY_CAP)",
   "definition": "Quinze saisies au plus par jour de réveil. Contrairement au sport et au temps pour soi, le sommeil refuse la seizième au lieu d'écraser la dernière."
  },
  {
   "terme": "SleepDayPoint",
   "definition": "Point de graphe d'une journée : Sommeil, Qualité, Nuit, Qualité nuit, Éveil et Kcal pour l'affichage, plus minutes, nightMinutes et awakeMinutes comme valeurs canoniques."
  },
  {
   "terme": "Palier de teinte (sleepBarTier)",
   "definition": "Entier de 1 à 5 valant ⌈5 × minutes / maxMinutes⌉ borné, relatif à la plus longue journée affichée ; commande les classes gc-sleep-t1 à t5."
  },
  {
   "terme": "Soirée d'une nuit",
   "definition": "Jour de rattachement d'une nuit sur la frise : bedDate si l'endormissement tombe à 12:00 ou après, la veille sinon."
  },
  {
   "terme": "Axe depuis midi",
   "definition": "Repère de la frise : depuisMidi(m) = ((m − 720) + 1440) mod 1440. Minuit vaut 720. reveilAxe = coucherAxe + durée peut dépasser 1 440, l'axe n'étant pas replié."
  },
  {
   "terme": "Moyenne circulaire",
   "definition": "Moyenne d'heures traitées comme des angles sur 24 h (somme vectorielle, atan2). Rend null si la résultante est quasi nulle. Seule le coucher moyen l'emploie."
  },
  {
   "terme": "Temps d'éveil (awakeMinutesOn)",
   "definition": "Du réveil le plus tardif du jour J à l'endormissement le plus précoce du jour J+1, siestes du jour J déduites ; null si une borne manque ou si le résultat est ≤ 0."
  },
  {
   "terme": "Fenêtre de période (PeriodWindow)",
   "definition": "'7days' | '14days' | '30days' | '90days' | 'all' | 'custom'. Inclusive, jour en cours compris, sans borne haute hors mode custom. Défaut 30days, persistée sous glp1_period_<clé>."
  },
  {
   "terme": "informedTrendMean",
   "definition": "Moyenne d'une série de tendance qui n'écarte que les null. La série du sommeil ne contenant que des nombres (0 les jours vides), tous les jours comptent."
  },
  {
   "terme": "Masquage complet",
   "definition": "isModuleHidden = module éteint ET drapeau sleepModuleHidden vrai. Le rallumage remet le drapeau à false dans la même écriture de profil."
  }
 ],
